# ── Backend API ─────────────────────────────────────────────────────────────
# Local:    http://localhost:8000
# Production: https://coachxyz-server.onrender.com (update after deploy)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Sentry ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=  # build-time only, for source map upload

# ── Identity boundary (optional) ────────────────────────────────────────────
# Shared secret between this app and the backend server. When set on BOTH
# sides, org/email/me/auth routes require x-service-token + verified auth0 id.
# ⚠️  NEVER commit a real value. Keep this secret out of logs, client bundles,
# screenshots, and version control. Rotate immediately if exposed.
# Generate a strong random secret (e.g., `openssl rand -hex 32`) and set it
# on both the server and the web app.
SERVICE_TOKEN=

# ── Identity-proxy limits ───────────────────────────────────────────────────
# Cap for bodies forwarded through /api/service (JSON org data, not uploads).
# SERVICE_PROXY_MAX_BODY_BYTES=2097152

# ── Auth0 ───────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=  # 64-char hex string, generate with: openssl rand -hex 32
