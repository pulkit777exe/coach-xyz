# ── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key

# ── Storage ───────────────────────────────────────────────────────────────────
# local (default): engine disk under LOCAL_STORAGE_DIR.
# s3: S3-compatible bucket (AWS S3, R2, MinIO via S3_ENDPOINT_URL) with
# browser-direct presigned uploads. boto3 is only imported on this path.
# STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./tmp/storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Redis (Upstash) ────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Shared with the Bun server and web app; required when deployed with
# production service authentication enabled.
SERVICE_TOKEN=

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ── CORS ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8000
