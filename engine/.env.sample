# ── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key

# ── Storage ─────────────────────────────────────────────────────────────────
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./tmp/storage

# ── R2 (only if STORAGE_BACKEND=r2) ────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=coachai-videos
