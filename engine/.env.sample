# ── Gemini AI ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_api_key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_ANALYSIS_TIMEOUT_S=600
# CHAT_GEMINI_TIMEOUT_S=100
# FFMPEG_TIMEOUT_S=300

# ── Storage ───────────────────────────────────────────────────────────────────
# local (default): engine disk under LOCAL_STORAGE_DIR.
# s3: S3-compatible bucket (AWS S3, R2, MinIO via S3_ENDPOINT_URL) with
# browser-direct presigned uploads. boto3 is only imported on this path.
# STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./tmp/storage
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Redis (Upstash) ────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
ENVIRONMENT=development

# ── CORS ────────────────────────────────────────────────────────────────────
SERVER_URL=http://localhost:8000

# ── Service auth ────────────────────────────────────────────────────────────
# Must match the server's SERVICE_TOKEN. When set, engine routes (except
# /health) require x-service-token.
# SERVICE_TOKEN=
# Set to 1 in every non-dev deploy: the engine then refuses to boot without
# SERVICE_TOKEN instead of silently serving all routes unauthenticated.
#REQUIRE_SERVICE_TOKEN=1
