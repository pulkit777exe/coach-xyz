# ── Gemini ───────────────────────────────────────────────────────────────────
# Works with any key, free tier included. Models are tried in order; one that is
# out of quota is skipped for a while. With no key, or no quota left, analysis
# still completes: coaching text is generated from the measurements.
GEMINI_API_KEY=
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# GEMINI_MIN_INTERVAL_S=2        # spacing between calls, keeps free-tier RPM happy
# GEMINI_TIMEOUT_S=240
# GEMINI_THINKING_BUDGET=0
# PROXY_MAX_SECONDS=150          # longest stretch of video sent to the model
# PROXY_FPS=5

# ── Engine ───────────────────────────────────────────────────────────────────
ENVIRONMENT=development          # production refuses to start without SERVICE_TOKEN
SERVICE_TOKEN=                   # same value as the server; also signs webhooks
SERVER_URL=http://localhost:8000 # CORS origin(s), comma separated
ENGINE_WORKERS=1                 # concurrent analyses (each needs roughly 300-500 MB)
ANALYSIS_FPS=12
POSE_MODEL=lite                  # lite | full | heavy
# POSE_MODEL_PATH=               # defaults to DATA_DIR/models/pose_landmarker_<model>.task (downloaded if missing)
MAX_UPLOAD_MB=500
SESSION_TTL_S=21600
RESULT_TTL_S=604800
LOG_LEVEL=INFO
# SENTRY_DSN=

# ── Storage ──────────────────────────────────────────────────────────────────
DATA_DIR=./data                  # database, uploads, results (use a persistent disk)
# STORAGE_BACKEND=local          # local | s3 (needs boto3)
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
