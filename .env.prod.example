# ── Required ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Postgres (analysis history, durable queue, share tokens, org data) ─────
# Neon/Supabase connection string. There is no Redis: the job queue is a
# Postgres table claimed with SKIP LOCKED, share tokens and AI report jobs are
# Postgres tables, and rate limiting is bounded in-memory per instance.
DATABASE_URL=

# ── Identity boundary (required in production) ─────────────────────────────
# Shared secret between web-next, the server, and the engine. Generate with
# `openssl rand -hex 32` and set the SAME value on all three.
# The server refuses to boot with REQUIRE_SERVICE_TOKEN=1 and no secret, and
# the engine refuses to boot with ENVIRONMENT=production and no secret.
SERVICE_TOKEN=
REQUIRE_SERVICE_TOKEN=1

# ── URLs ────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
PORT=8000
WORKER_CONCURRENCY=2
# REPORT_WORKER_CONCURRENCY=1
# RETENTION_DAYS=365
# ORG_DAILY_ANALYSIS_LIMIT=50

# ── Storage (engine) ────────────────────────────────────────────────────────
# SQLite DB, uploads and rendered results all live under DATA_DIR.
DATA_DIR=/app/data
# STORAGE_BACKEND=local (default) or s3 for shared/production storage.
# STORAGE_BACKEND=
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Auth0 (web-next) ────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=

# ── Email (Resend) — player invites, report + attendance delivery ───────────
# Without RESEND_API_KEY the email routes return 501 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
RESEND_FROM_NAME=CoachXYZ

# ── Observability ───────────────────────────────────────────────────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
