# ── Required ────────────────────────────────────────────────────────────────
NODE_ENV=production
GEMINI_API_KEY=your_gemini_api_key_here

# ── Redis (Upstash REST API) ────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional ────────────────────────────────────────────────────────────────
DATABASE_URL=
FRONTEND_URL=http://localhost:3000
PORT=8000
WORKER_CONCURRENCY=2

# ── Email (Resend) — player invites, report + attendance delivery ───────────
# Without RESEND_API_KEY the email routes return 501 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=
RESEND_FROM_NAME=CoachXYZ

# ── Identity boundary (set on BOTH server and web-next) ─────────────────────
SERVICE_TOKEN=