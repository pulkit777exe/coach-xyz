{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start All (Server + Engine + Frontend)",
      "dependsOn": [
        "Engine: Start Dev Server",
        "Backend: Start Development Server",
        "Frontend: Start Development Server"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Start Backend (Server + Engine)",
      "dependsOn": [
        "Engine: Start Dev Server",
        "Backend: Start Development Server"
      ],
      "dependsOrder": "parallel",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Engine: Start Dev Server",
      "type": "shell",
      "command": "cd engine && ./.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8001 --reload",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "Engine: Install Dependencies",
      "type": "shell",
      "command": "cd engine && python3 -m venv .venv && ./.venv/bin/pip install --upgrade pip && ./.venv/bin/pip install -r requirements.txt",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Backend: Start Development Server",
      "type": "shell",
      "command": "cd server && bun run dev",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    },
    {
      "label": "Frontend: Start Development Server",
      "type": "shell",
      "command": "cd web-next && bun run dev",
      "group": "none",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      },
      "isBackground": true
    }
  ],
  "inputs": [
    {
      "id": "videoPath",
      "type": "promptString",
      "description": "Path to the video file to analyze",
      "default": "video2.mp4"
    }
  ]
}
