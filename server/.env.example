# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ── Engine ──────────────────────────────────────────────────────────────────
ENGINE_URL=http://localhost:8001
WORKER_CONCURRENCY=1

# ── Redis (Upstash REST API) ────────────────────────────────────────────────
# Get these from https://console.upstash.com
# Used for: rate limiting, caching, BullMQ queue
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate Limiting ───────────────────────────────────────────────────────────
SCAN_RATE_LIMIT=10
ANALYSIS_RATE_LIMIT=5
CHAT_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=60
SCAN_PROGRESS_RATE_LIMIT=30

# ── Retention (§30) ──────────────────────────────────────────────────────────
# Analyses (+ findings + chat) older than this are pruned by the daily sweep.
RETENTION_DAYS=365

# ── Supabase (optional) ────────────────────────────────────────────────────
DATABASE_URL=

# ── Email (Resend) — used for player invites, report + attendance delivery ─
# Get a key from https://resend.com/api-keys. Without it the email routes
# return 501 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
# Sending domain verified in Resend (falls back to onboarding@resend.dev).
RESEND_FROM_DOMAIN=
RESEND_FROM_NAME=CoachXYZ

# ── Identity boundary (optional) ────────────────────────────────────────────
# Shared secret between this server and the Next app. When set on BOTH sides
# the org/email/me/auth routes require x-service-token + a verified auth0 id.
SERVICE_TOKEN=

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=