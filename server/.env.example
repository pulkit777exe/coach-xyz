# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# ── Engine ──────────────────────────────────────────────────────────────────
ENGINE_URL=http://localhost:8001
WORKER_CONCURRENCY=1
REPORT_WORKER_CONCURRENCY=1

# ── Postgres (analysis history, durable queue, share tokens, org data) ─────
# Required DATABASE_URL (Neon / Supabase proxy). No Redis anywhere: the job
# queue is a Postgres table claimed with SKIP LOCKED, share tokens and AI
# report jobs are Postgres tables, and rate limiting is bounded in-memory
# per instance. ANALYSIS_POLL_MS / *_DRAIN_BATCH are optional tuning knobs.
# ANALYSIS_POLL_MS=1000
# ANALYSIS_DRAIN_BATCH=4
# REPORT_DRAIN_BATCH=2
DATABASE_URL=

# ── Rate Limiting ───────────────────────────────────────────────────────────
SCAN_RATE_LIMIT=10
ANALYSIS_RATE_LIMIT=5
CHAT_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=60
SCAN_PROGRESS_RATE_LIMIT=30
CLIP_RATE_LIMIT=60
EMAIL_RATE_LIMIT=20
AI_REPORT_RATE_LIMIT=10

# ── Retention (§30) ──────────────────────────────────────────────────────────
# Analyses (+ findings + clips + player events + chat) older than this are
# pruned by the daily sweep.
RETENTION_DAYS=365

# ── Fair queueing (§17) ─────────────────────────────────────────────────────
# Max analyses started per org per UTC day (429 past the cap).
ORG_DAILY_ANALYSIS_LIMIT=50

# ── Supabase (optional) ────────────────────────────────────────────────────
DATABASE_URL=

# ── Email (Resend) — used for player invites, report + attendance delivery ─
# Get a key from https://resend.com/api-keys. Without it the email routes
# return 501 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
# Sending domain verified in Resend (falls back to onboarding@resend.dev).
RESEND_FROM_DOMAIN=
RESEND_FROM_NAME=CoachXYZ

# ── Identity boundary (optional) ────────────────────────────────────────────
# Shared secret between this server and the Next app. When set on BOTH sides
# the org/email/me/auth routes require x-service-token + a verified auth0 id.
# THIS VALUE MUST NEVER BE COMMITTED TO VERSION CONTROL.
# Generate a strong random secret (e.g., `openssl rand -hex 32`) and set it
# on both the server and the web app. The web app reads it from
# NEXT_PUBLIC_API_URL + the server from the SERVICE_TOKEN env var.
SERVICE_TOKEN=

# Set to 1 in every production deploy: the server then refuses to boot
# without SERVICE_TOKEN instead of silently running with all guards open.
#REQUIRE_SERVICE_TOKEN=1

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=
