# ── Server ──────────────────────────────────────────────────────────────────
PORT=8000
# Local sample stays development; Render sets NODE_ENV=production explicitly.
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ── Engine ──────────────────────────────────────────────────────────────────
ENGINE_URL=http://localhost:8001
WORKER_CONCURRENCY=1

# ── Redis (Upstash REST API) ────────────────────────────────────────────────
# Get these from https://console.upstash.com
# Used for: rate limiting, caching, BullMQ queue, cross-replica SSE events
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Rate Limiting ───────────────────────────────────────────────────────────
SCAN_RATE_LIMIT=10
ANALYSIS_RATE_LIMIT=5
CHAT_RATE_LIMIT=30
DOWNLOAD_RATE_LIMIT=60
SCAN_PROGRESS_RATE_LIMIT=30
CLIP_RATE_LIMIT=60

# ── Retention (§30) ──────────────────────────────────────────────────────────
# Analyses (+ findings + chat) older than this are pruned by the daily sweep.
RETENTION_DAYS=365

# ── Fair queueing (§17) ─────────────────────────────────────────────────────
# Max analyses started per org per UTC day (429 past the cap).
ORG_DAILY_ANALYSIS_LIMIT=50

# ── Supabase (optional) ────────────────────────────────────────────────────
DATABASE_URL=

# ── Email (Resend) — used for player invites, report + attendance delivery ─
# Get a key from https://resend.com/api-keys. Without it the email routes
# return 501 EMAIL_NOT_CONFIGURED.
RESEND_API_KEY=
# Sending domain verified in Resend (falls back to onboarding@resend.dev).
RESEND_FROM_DOMAIN=
RESEND_FROM_NAME=CoachXYZ

# ── Identity boundary (optional) ────────────────────────────────────────────
# Shared secret between this server, the engine, and the Next app. Required
# when NODE_ENV=production; set the same value on all three services.
SERVICE_TOKEN=

# ── Sentry ──────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Logging ─────────────────────────────────────────────────────────────────
# Level: error|warn|info|http|debug — default info
LOG_LEVEL=
# Format: json|pretty — default json in production, pretty otherwise
LOG_FORMAT=
